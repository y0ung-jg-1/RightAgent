<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <PerUser Condition="'$(PerUser)' == ''">true</PerUser>
    <OutputName Condition="'$(PerUser)' == 'true'">RightAgentUserSetup</OutputName>
    <OutputName Condition="'$(PerUser)' != 'true'">RightAgentSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AcceptEula>wix7</AcceptEula>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>PerUser=$(PerUser);Version=$(Version);MsiPath=$(MsiPath);PayloadDir=$(PayloadDir);RepoDir=$(RepoDir);CertThumbprint=$(CertThumbprint)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
