<Application
    x:Class="RightAgent.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="SettingsCardWrapThreshold">200</x:Double>
                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">120</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="SettingsCardWrapThreshold">200</x:Double>
                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">120</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="SettingsCardWrapThreshold">200</x:Double>
                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">120</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <!-- SettingsExpander headers otherwise left-align and size-to-content. -->
            <HorizontalAlignment x:Key="ExpanderHeaderHorizontalContentAlignment">Stretch</HorizontalAlignment>
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
