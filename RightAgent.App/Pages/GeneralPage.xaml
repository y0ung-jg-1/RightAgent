<Page
    x:Class="RightAgent.App.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer
        Padding="36,16,52,24"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                Margin="0,0,0,12"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.GeneralSectionLabel, Mode=OneWay}" />

            <controls:SettingsCard CornerRadius="8" Header="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    MinHeight="44"
                    AutomationProperties.Name="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}"
                    SelectedValuePath="Key" />
            </controls:SettingsCard>

            <controls:SettingsCard CornerRadius="8" Header="{x:Bind ViewModel.TerminalProfileLabel, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="240"
                    MinHeight="44"
                    MaxDropDownHeight="360"
                    AutomationProperties.HelpText="{x:Bind ViewModel.TerminalProfileHelp, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.TerminalProfileLabel, Mode=OneWay}"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.TerminalProfileOptions, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.TerminalProfile, Mode=TwoWay}"
                    SelectedValuePath="Key"
                    ToolTipService.ToolTip="{x:Bind ViewModel.TerminalProfileHelp, Mode=OneWay}" />
            </controls:SettingsCard>

            <TextBlock
                Margin="4,16,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.Name="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
