        "schemaVersion": 1,
        "menuEnabled": true,
        "language": "system",
        "menuMode": "grouped",
        "directAgentId": "upper-url",
        "terminalProfile": null,
        "agents": [
          { "id": "upper-url", "name": "UpperUrl", "enabled": true, "sort": 0, "iconPath": "builtin:rightagent", "action": { "type": "terminalCommand", "value": "https://example.com" } },
          { "id": "normal-url", "name": "NormalUrl", "enabled": true, "sort": 1, "iconPath": "builtin:rightagent", "action": { "type": "url", "value": "https://example.com" } }
        ]
      }
    },
    {
      "name": "missing sorts default to zero and ties keep document order",
      "input": {
        "schemaVersion": 1,
        "agents": [
          { "id": "nos", "name": "No Sort", "enabled": true, "action": { "type": "terminalCommand", "value": "n" } },
          { "id": "zero", "name": "Zero", "enabled": true, "sort": 0, "action": { "type": "terminalCommand", "value": "z" } },
          { "id": "neg", "name": "Neg", "enabled": true, "sort": -1, "action": { "type": "terminalCommand", "value": "g" } }
        ]
      },
      "expected": {
        "schemaVersion": 1,
        "menuEnabled": true,
        "language": "system",
        "menuMode": "grouped",
        "directAgentId": "neg",
        "terminalProfile": null,
        "agents": [
          { "id": "neg", "name": "Neg", "enabled": true, "sort": 0, "iconPath": "builtin:rightagent", "action": { "type": "terminalCommand", "value": "g" } },
          { "id": "nos", "name": "No Sort", "enabled": true, "sort": 1, "iconPath": "builtin:rightagent", "action": { "type": "terminalCommand", "value": "n" } },
          { "id": "zero", "name": "Zero", "enabled": true, "sort": 2, "iconPath": "builtin:rightagent", "action": { "type": "terminalCommand", "value": "z" } }
        ]
      }
