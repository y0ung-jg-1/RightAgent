<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The App's build targets flow in transitively; this host must not
         generate its own PRI (Localization reads the copied App PRI). -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Resolve the App's transitive MSIX tooling from the package, not the
         Windows SDK install, matching RightAgent.App. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RightAgent.App\RightAgent.App.csproj" />
    <ProjectReference Include="..\RightAgent.Core\RightAgent.Core.csproj" />
  </ItemGroup>
  <!-- Localization reads RightAgent.App.pri next to the test host. Resolve
       it from the App project output instead of a hard-coded TFM path. -->
  <Target Name="CopyAppResources" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_AppAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'RightAgent.App'" />
    </ItemGroup>
    <Error Condition="'@(_AppAssembly)' == ''" Text="Could not resolve RightAgent.App output from the project reference." />
    <PropertyGroup>
      <_AppPriPath>%(_AppAssembly.RootDir)%(_AppAssembly.Directory)RightAgent.App.pri</_AppPriPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AppPriPath)')" Text="RightAgent.App.pri was not found at $(_AppPriPath)." />
    <Copy SourceFiles="$(_AppPriPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
